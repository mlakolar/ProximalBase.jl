+@testset "IndSOC and IndRotatedSOC: low-precision BigFloat scales are unchanged" begin
+  setprecision(BigFloat, 5) do
+    a = ldexp(one(BigFloat), Clong(35))
+    x = fill(a, 3)
+    @test iszero(IndRotatedSOC()(x))
+    M = floatmax(BigFloat)
+    z = fill(M, 2)
+    @test iszero(IndSOC()(z))
+    @test prox(IndSOC(), z) == z
+  end
+end
