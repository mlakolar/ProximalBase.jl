   A, u = m.A, m.u
   G = atomindices(x, k)
   n = length(G)
@@ -67,7 +78,9 @@ function _groupstep!(m::QuadModel{T}, g::AbstractFunction, x::AtomIterate{T}, k:
     buf[n + i] = old
