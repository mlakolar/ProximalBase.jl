+# d .= z .- Y and g .= Xᵀd (d may be z itself); with a level α, also the value α‖d‖²/2 by the shared
+# squared-residual kernel (α kept as supplied, rounded once at the result).
+@inline function _leastsquares_residual_gradient!(g, d, X, z, Y)
+  d .= z .- Y
+  mul!(g, transpose(X), d)
